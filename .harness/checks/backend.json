{
  "name": "backend: lint, bootstrap, contract",
  "when_exists": ["backend/pyproject.toml", "backend/app/**/*.py"],
  "cwd": ".",
  "commands": [
    ["{python}", "-m", "ruff", "check", "--config", "backend/pyproject.toml", "backend", "tests/unit/bootstrap"],
    ["{python}", "-m", "pytest", "-c", "backend/pyproject.toml", "tests/unit", "tests/contract"],
    ["{python}", "docs/design/a/check_contract.py"]
  ],
  "setup_commands": [
    ["{python}", "-m", "pip", "install", "-r", "backend/requirements-dev.txt", "-e", "./backend[dev]"]
  ]
}
