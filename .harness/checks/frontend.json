{
  "name": "frontend: lint, CI-тесты и сборка",
  "when_exists": [
    "frontend/package.json"
  ],
  "cwd": "frontend",
  "commands": [
    [
      "{python}",
      "scripts/run_node.py",
      "npm",
      "run",
      "lint"
    ],
    [
      "{python}",
      "scripts/run_node.py",
      "npm",
      "run",
      "test:ci"
    ],
    [
      "{python}",
      "scripts/run_node.py",
      "npm",
      "run",
      "build"
    ],
    [
      "{python}",
      "scripts/run_node.py",
      "npm",
      "run",
      "test:e2e"
    ]
  ],
  "setup_commands": [
    [
      "{python}",
      "scripts/run_node.py",
      "npm",
      "ci"
    ],
    [
      "{python}",
      "scripts/run_node.py",
      "npx",
      "playwright",
      "install",
      "--with-deps",
      "chromium"
    ]
  ]
}
